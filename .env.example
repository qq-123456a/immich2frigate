# Copy to .env for local development. Never put real credentials in Git.
# Use HTTPS across untrusted networks. Plain HTTP is only suitable on an isolated trusted network.
IMMICH_URL=http://host.docker.internal:2283
IMMICH_API_KEY=
# Use a dedicated read-only PostgreSQL account. The application also forces
# default_transaction_read_only=on for every vector-store connection.
IMMICH_DATABASE_URL=postgresql://immich2frigate_reader:CHANGE_ME@immich-database:5432/immich
FRIGATE_URL=http://frigate:5000
